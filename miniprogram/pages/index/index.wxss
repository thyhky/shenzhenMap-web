page { background: #d9d1c1; }
.page, .map { width: 100%; height: 100vh; }
.brand-card, .stats-card, .filter-card, .results-card, .detail-card, .error-card {
  position: fixed;
  z-index: 2;
  border: 1rpx solid rgba(255, 255, 255, .7);
  border-radius: 12rpx;
  background: rgba(250, 246, 237, .94);
  box-shadow: 0 12rpx 36rpx rgba(18, 42, 46, .16);
}
.brand-card { top: 24rpx; left: 24rpx; display: flex; flex-direction: column; padding: 20rpx 24rpx; }
.brand-kicker { color: #b64c39; font-size: 18rpx; letter-spacing: 2rpx; }
.title { margin-top: 6rpx; color: #17343a; font-family: serif; font-size: 40rpx; font-weight: 700; }
.subtitle { margin-top: 4rpx; color: #617074; font-size: 20rpx; }
.stats-card { top: 24rpx; right: 24rpx; display: flex; gap: 28rpx; padding: 18rpx 22rpx; }
.stats-card view { display: flex; flex-direction: column; color: #718084; font-size: 18rpx; }
.stats-card .value { margin-top: 4rpx; color: #17343a; font-family: serif; font-size: 30rpx; font-weight: 700; }
.filter-card { top: 168rpx; left: 24rpx; padding: 14rpx; }
.picker { min-width: 250rpx; border-bottom: 1rpx solid rgba(23, 52, 58, .16); padding: 13rpx 8rpx; color: #40565a; font-size: 23rpx; }
.tool-row { display: flex; gap: 8rpx; margin-top: 12rpx; }
.tool-row button { margin: 0; border: 1rpx solid #9caaa9; background: transparent; color: #315b6d; font-size: 19rpx; line-height: 1.8; }
.results-card { top: 168rpx; right: 24rpx; bottom: 30rpx; width: 330rpx; padding: 18rpx; }
.results-head { display: flex; justify-content: space-between; border-bottom: 1rpx solid rgba(23, 52, 58, .16); padding-bottom: 14rpx; color: #17343a; font-size: 25rpx; font-weight: 700; }
.close { color: #b64c39; font-size: 20rpx; font-weight: 400; }
.results-scroll { height: calc(100% - 54rpx); }
.result-row { display: flex; justify-content: space-between; gap: 12rpx; border-bottom: 1rpx solid rgba(23, 52, 58, .1); padding: 15rpx 0; }
.result-row view { display: flex; flex-direction: column; min-width: 0; }
.result-name { overflow: hidden; color: #17343a; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.result-meta { margin-top: 5rpx; color: #7a8587; font-size: 18rpx; }
.result-price { flex: none; color: #b64c39; font-size: 20rpx; }
.detail-card { right: 24rpx; bottom: 180rpx; left: 24rpx; display: flex; flex-direction: column; gap: 7rpx; padding: 20rpx; color: #617074; font-size: 20rpx; }
.detail-name { color: #17343a; font-size: 28rpx; font-weight: 700; }
.loading-mask { position: fixed; inset: 0; z-index: 5; display: flex; align-items: center; justify-content: center; background: rgba(217, 209, 193, .88); color: #17343a; font-size: 28rpx; }
.error-card { top: 45%; right: 50rpx; left: 50rpx; display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding: 30rpx; color: #7e3028; text-align: center; }
