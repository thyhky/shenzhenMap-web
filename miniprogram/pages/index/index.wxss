.page,
web-view {
  width: 100%;
  height: 100vh;
}

.loading-mask,
.error-card {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
}

.loading-mask {
  top: 0;
  background: #d9d1c1;
}

.loading-card,
.error-card {
  border-radius: 16rpx;
  background: #faf6ed;
  color: #17343a;
  box-shadow: 0 16rpx 45rpx rgba(18, 42, 46, 0.16);
}

.loading-card {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
}

.error-card {
  top: 35%;
  right: 48rpx;
  bottom: auto;
  left: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 40rpx 32rpx;
  text-align: center;
}

.error-title {
  font-size: 34rpx;
  font-weight: 700;
}

.error-copy {
  color: #617074;
  font-size: 26rpx;
  line-height: 1.6;
}
