page { background: #d9d1c1; }
.page, .map { width: 100%; height: 100vh; }
.brand-card, .stats-card, .filter-card, .results-card, .detail-card, .error-card {
  position: fixed;
  z-index: 2;
  border: 1rpx solid rgba(255, 255, 255, .7);
  border-radius: 12rpx;
  background: rgba(250, 246, 237, .94);
  box-shadow: 0 12rpx 36rpx rgba(18, 42, 46, .16);
}
.brand-card { top: calc(20rpx + env(safe-area-inset-top)); left: 20rpx; display: flex; flex-direction: column; padding: 16rpx 20rpx; }
.brand-kicker { color: #b64c39; font-size: 18rpx; letter-spacing: 2rpx; }
.title { margin-top: 4rpx; color: #17343a; font-family: serif; font-size: 34rpx; font-weight: 700; }
.subtitle { display: none; }
.stats-card { top: calc(20rpx + env(safe-area-inset-top)); right: 20rpx; display: flex; gap: 22rpx; padding: 15rpx 18rpx; }
.stats-card view { display: flex; flex-direction: column; color: #718084; font-size: 18rpx; }
.stats-card .value { margin-top: 4rpx; color: #17343a; font-family: serif; font-size: 27rpx; font-weight: 700; }
.filter-card { top: 168rpx; left: 24rpx; width: 440rpx; padding: 10rpx 12rpx 12rpx; }
.filter-head { display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid rgba(23, 52, 58, .12); margin-bottom: 6rpx; padding-bottom: 6rpx; color: #17343a; font-size: 25rpx; font-weight: 700; }
.filter-close { color: #b64c39; font-size: 30rpx; font-weight: 400; line-height: 1; padding: 2rpx 4rpx 2rpx 16rpx; }
.filter-row { display: flex; gap: 12rpx; margin-top: 6rpx; }
.picker-flex { flex: 1; min-width: 0; }
.picker { min-width: 250rpx; border-bottom: 1rpx solid rgba(23, 52, 58, .16); padding: 9rpx 6rpx; color: #40565a; font-size: 21rpx; }
.keyword-input { min-width: 250rpx; border-bottom: 1rpx solid rgba(23, 52, 58, .16); padding: 9rpx 6rpx; color: #40565a; font-size: 21rpx; }
.tool-row { display: flex; gap: 8rpx; margin-top: 10rpx; }
.tool-row button { margin: 0; border: 1rpx solid #9caaa9; background: transparent; color: #315b6d; font-size: 17rpx; line-height: 1.7; }
.export-row { display: flex; gap: 8rpx; margin-top: 8rpx; }
.export-row button { margin: 0; flex: 1; }
.export-button { margin-top: 8rpx; border: 1rpx solid rgba(182, 76, 57, .42); background: rgba(182, 76, 57, .08); color: #8f3a2b; font-size: 17rpx; line-height: 1.7; }
.price-row { display: flex; align-items: center; gap: 7rpx; margin-top: 9rpx; color: #617074; font-size: 18rpx; }
.price-row input { width: 76rpx; border-bottom: 1rpx solid rgba(23, 52, 58, .16); padding: 4rpx; text-align: center; }
.check-row { display: flex; align-items: center; margin-top: 6rpx; color: #40565a; font-size: 18rpx; }
.check-row checkbox { transform: scale(.7); }
.apply-row { display: flex; gap: 8rpx; margin-top: 8rpx; }
.apply-row button { margin: 0; }
.apply-button { flex: 1; background: #315b6d; font-size: 18rpx; }
.more-tools { border: 1rpx solid rgba(49, 91, 109, .35); background: transparent; color: #315b6d; font-size: 18rpx; }
.filter-reopen { position: fixed; top: 168rpx; left: 24rpx; z-index: 2; border: 1rpx solid rgba(255, 255, 255, .7); border-radius: 99rpx; background: rgba(250, 246, 237, .95); padding: 12rpx 28rpx; color: #315b6d; font-size: 24rpx; box-shadow: 0 12rpx 36rpx rgba(18, 42, 46, .16); }
.filter-reopen.results-reopen { right: 24rpx; left: auto; }
.results-card { top: 168rpx; right: 24rpx; bottom: 30rpx; width: 330rpx; padding: 18rpx; }
.results-head { display: flex; justify-content: space-between; align-items: center; border-bottom: 1rpx solid rgba(23, 52, 58, .16); padding-bottom: 14rpx; color: #17343a; font-size: 25rpx; font-weight: 700; }
.close { color: #b64c39; font-size: 28rpx; font-weight: 400; line-height: 1; padding: 0 4rpx 0 16rpx; }
.results-scroll { height: calc(100% - 54rpx); }
.result-filter-input { border: 1rpx solid rgba(49, 91, 109, .35); border-radius: 20rpx; margin-top: 12rpx; padding: 8rpx 18rpx; color: #17343a; font-size: 19rpx; }
.result-filter-input::placeholder { color: #9aa5a6; }
.result-row { display: flex; justify-content: space-between; gap: 12rpx; border-bottom: 1rpx solid rgba(23, 52, 58, .1); padding: 15rpx 0; }
.result-row view { display: flex; flex-direction: column; min-width: 0; }
.result-name { overflow: hidden; color: #17343a; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.result-meta { margin-top: 5rpx; color: #7a8587; font-size: 18rpx; }
.result-price { flex: none; color: #b64c39; font-size: 20rpx; }
.ranking-head { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid rgba(23, 52, 58, .16); color: #17343a; font-size: 24rpx; font-weight: 700; }
.ranking-switch { display: flex; gap: 10rpx; }
.ranking-switch text { border: 1rpx solid rgba(49, 91, 109, .35); border-radius: 20rpx; padding: 4rpx 10rpx; color: #315b6d; font-size: 18rpx; font-weight: 400; }
.ranking-switch .active { border-color: rgba(182, 76, 57, .5); color: #b64c39; background: rgba(182, 76, 57, .08); }
.ranking-row { align-items: center; }
.rank-row-main { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.rank-label { display: inline-flex; align-items: center; justify-content: center; width: 44rpx; height: 30rpx; border-radius: 16rpx; background: #e6d8c2; color: #8a6145; font-size: 16rpx; }
.ranking-empty { padding: 16rpx 0; color: #617074; font-size: 19rpx; text-align: center; }
.detail-card { right: 24rpx; bottom: 180rpx; left: 24rpx; display: flex; flex-direction: column; gap: 7rpx; padding: 20rpx; color: #617074; font-size: 20rpx; }
.detail-card button { align-self: flex-start; margin: 8rpx 0 0; background: #315b6d; font-size: 20rpx; }
.detail-name { color: #17343a; font-size: 28rpx; font-weight: 700; }
.loading-mask { position: fixed; top: calc(126rpx + env(safe-area-inset-top)); left: 50%; transform: translateX(-50%); z-index: 5; border-radius: 24rpx; background: rgba(23, 52, 58, .85); padding: 10rpx 26rpx; color: #faf6ed; font-size: 22rpx; }
.error-card { top: 45%; right: 50rpx; left: 50rpx; display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding: 30rpx; color: #7e3028; text-align: center; }
.source-button { align-self: flex-start; margin-top: 10rpx; border: 0; border-bottom: 1rpx solid currentColor; background: transparent; padding: 0; color: #315b6d; font-size: 18rpx; line-height: 1.6; }
.history-list { display: flex; flex-direction: column; gap: 4rpx; margin-top: 4rpx; }
.history-row { display: flex; justify-content: space-between; color: #40565a; font-size: 18rpx; }
.history-note { color: #7a8587; font-size: 16rpx; }
.history-periods { display: flex; gap: 8rpx; margin: 2rpx 0; }
.history-period { border: 1rpx solid #d4d4d4; background: #fff; color: #7a8587; border-radius: 4rpx; padding: 2rpx 14rpx; font-size: 18rpx; }
.history-period.active { background: #7a4b2e; border-color: #7a4b2e; color: #fff; }
.heatmap-canvas { position: fixed; inset: 0; z-index: 8; width: 100%; height: 100%; background: rgba(217, 209, 193, .9); }
.methodology-mask { position: fixed; inset: 0; z-index: 9; display: flex; align-items: center; justify-content: center; background: rgba(23, 52, 58, .42); }
.methodology-card { width: 84%; max-height: 74%; display: flex; flex-direction: column; border: 1rpx solid rgba(255, 255, 255, .7); border-radius: 12rpx; background: #faf6ed; padding: 22rpx; color: #40565a; font-size: 20rpx; }
.methodology-head { display: flex; justify-content: space-between; align-items: center; border-bottom: 1rpx solid rgba(23, 52, 58, .16); padding-bottom: 12rpx; }
.methodology-title { color: #17343a; font-size: 28rpx; font-weight: 700; }
.methodology-close { color: #b64c39; font-size: 20rpx; }
.methodology-disclaimer { margin-top: 12rpx; color: #617074; font-size: 18rpx; line-height: 1.6; }
.methodology-scroll { margin-top: 12rpx; max-height: 60%; }
.scope-card { display: flex; flex-direction: column; gap: 6rpx; border-bottom: 1rpx solid rgba(23, 52, 58, .1); padding: 14rpx 0; }
.scope-head { display: flex; justify-content: space-between; align-items: center; }
.scope-label { color: #17343a; font-size: 22rpx; font-weight: 700; }
.scope-status { border-radius: 16rpx; padding: 2rpx 10rpx; font-size: 16rpx; }
.scope-status.active { background: rgba(45, 129, 124, .12); color: #2d817c; }
.scope-status.planned { background: rgba(227, 182, 87, .16); color: #8a6a1a; }
.scope-source { color: #315b6d; font-size: 18rpx; }
.scope-line { color: #617074; font-size: 17rpx; line-height: 1.5; }
.scope-note { color: #7a8587; font-size: 16rpx; line-height: 1.5; }
.methodology-foot { margin-top: 12rpx; border-top: 1rpx solid rgba(23, 52, 58, .1); padding-top: 10rpx; color: #7a8587; font-size: 16rpx; }

.sheet-mask { position: fixed; inset: 0; z-index: 7; background: rgba(11, 31, 35, .34); }
.bottom-sheet { position: fixed; right: 0; bottom: 0; left: 0; z-index: 8; max-height: 74vh; border-radius: 30rpx 30rpx 0 0; background: #faf6ed; box-shadow: 0 -18rpx 60rpx rgba(12, 35, 39, .28); padding-bottom: env(safe-area-inset-bottom); }
.sheet-handle { width: 70rpx; height: 7rpx; margin: 14rpx auto 7rpx; border-radius: 99rpx; background: #c0b9ae; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid rgba(23, 52, 58, .14); padding: 14rpx 28rpx; color: #17343a; font-family: serif; font-size: 28rpx; font-weight: 700; }
.sheet-close { min-width: 80rpx; padding: 8rpx 0; color: #b64c39; font-family: sans-serif; font-size: 21rpx; font-weight: 400; text-align: right; }
.sheet-scroll { max-height: calc(74vh - 96rpx - env(safe-area-inset-bottom)); }
.sheet-content { padding: 22rpx 28rpx 34rpx; }
.sheet-content .keyword-input { width: auto; min-width: 0; border: 1rpx solid rgba(23, 52, 58, .16); border-radius: 10rpx; background: #fff; padding: 17rpx 18rpx; font-size: 23rpx; }
.sheet-content .filter-row { gap: 16rpx; margin-top: 18rpx; }
.sheet-content .filter-row picker { flex: 1; min-width: 0; }
.sheet-content .picker { min-width: 0; border: 1rpx solid rgba(23, 52, 58, .16); border-radius: 10rpx; background: #fff; padding: 17rpx 14rpx; font-size: 22rpx; }
.sheet-content .price-row { margin-top: 22rpx; font-size: 21rpx; }
.sheet-content .price-row input { width: 110rpx; border: 1rpx solid rgba(23, 52, 58, .16); border-radius: 8rpx; background: #fff; padding: 9rpx 6rpx; }
.sheet-content .check-row { margin-top: 16rpx; font-size: 21rpx; }
.sheet-content .tool-row { margin-top: 18rpx; }
.sheet-content .tool-row button { flex: 1; padding: 7rpx 4rpx; font-size: 20rpx; }
.sheet-content .apply-row { margin-top: 20rpx; }
.sheet-content .apply-row button { padding-block: 7rpx; font-size: 21rpx; }
.sheet-content .results-head { padding-bottom: 14rpx; font-size: 22rpx; }
.sheet-content .result-filter-input { border-radius: 10rpx; padding: 15rpx 18rpx; font-size: 21rpx; }
.sheet-content .result-row { min-height: 72rpx; padding: 19rpx 0; }
.sheet-content .result-name { font-size: 25rpx; }
.sheet-content .result-price { font-size: 23rpx; }
.detail-sheet { display: flex; flex-direction: column; gap: 12rpx; color: #617074; font-size: 22rpx; line-height: 1.55; }
.detail-sheet .detail-name { font-size: 32rpx; }
.detail-sheet button { align-self: flex-start; margin: 10rpx 0 0; background: #315b6d; font-size: 21rpx; }
.detail-empty { padding: 80rpx 20rpx; color: #7a8587; text-align: center; }
.bottom-nav { position: fixed; right: 0; bottom: 0; left: 0; z-index: 6; display: grid; grid-template-columns: repeat(3, 1fr); min-height: calc(104rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(255, 255, 255, .7); background: rgba(250, 246, 237, .96); padding: 8rpx 12rpx env(safe-area-inset-bottom); box-shadow: 0 -12rpx 36rpx rgba(18, 42, 46, .14); }
.nav-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; border-right: 1rpx solid rgba(23, 52, 58, .13); color: #17343a; font-size: 24rpx; font-weight: 700; }
.nav-item:last-child { border-right: 0; }
.nav-item.active { color: #b64c39; }
.nav-meta { max-width: 190rpx; overflow: hidden; color: #7a8587; font-size: 17rpx; font-weight: 400; text-overflow: ellipsis; white-space: nowrap; }
.map-brief { position: fixed; right: 20rpx; bottom: calc(122rpx + env(safe-area-inset-bottom)); left: 20rpx; z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border: 1rpx solid rgba(23, 52, 58, .16); border-radius: 14rpx; background: rgba(250, 246, 237, .97); padding: 17rpx 20rpx; box-shadow: 0 12rpx 38rpx rgba(18, 42, 46, .2); }
.brief-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: 5rpx; }
.brief-name { overflow: hidden; color: #17343a; font-family: serif; font-size: 27rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.brief-meta { overflow: hidden; color: #617074; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.brief-actions { display: flex; flex: none; align-items: center; gap: 18rpx; color: #b64c39; font-size: 20rpx; }
.brief-close { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; background: rgba(23, 52, 58, .07); color: #617074; font-size: 29rpx; line-height: 1; }
