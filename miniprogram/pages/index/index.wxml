<view class="page">
  <map
    id="main-map"
    class="map"
    longitude="{{longitude}}"
    latitude="{{latitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    circles="{{circles}}"
    polygons="{{visiblePolygons}}"
    enable-zoom
    enable-scroll
    enable-rotate
    bindmarkertap="handleMarkerTap"
    bindtap="handleMapTap"
    bindregionchange="handleRegionChange"
  ></map>

  <view class="brand-card">
    <text class="brand-kicker">SHENZHEN · HOUSING ATLAS</text>
    <text class="title">深圳住区观察</text>
    <text class="subtitle">小区价格、学校和学区地图</text>
    <text class="source-button" bindtap="toggleMethodology">数据来源与方法</text>
  </view>

  <view class="stats-card">
    <view><text>小区</text><text class="value">{{total}}</text></view>
    <view><text>均价</text><text class="value">{{averagePrice}}</text></view>
  </view>

  <view wx:if="{{showFilters}}" class="filter-card">
    <view class="filter-head">
      <text>筛选</text>
      <text class="filter-close" bindtap="toggleFilters">×</text>
    </view>
    <input class="keyword-input" value="{{keyword}}" placeholder="小区名称" bindinput="handleKeywordInput" confirm-type="search" bindconfirm="applyFilters" />
    <view class="filter-row">
      <picker mode="selector" range="{{districtOptions}}" value="{{districtIndex}}" bindchange="selectDistrict">
        <view class="picker picker-flex">区域：{{district || '全部区域'}}⌄</view>
      </picker>
      <picker mode="selector" range="{{streetOptions}}" range-key="name" value="{{streetIndex}}" bindchange="selectStreet">
        <view class="picker picker-flex">街道：{{street || '全部街道'}}⌄</view>
      </picker>
    </view>
    <view class="tool-row">
      <button size="mini" bindtap="toggleSchools">{{showSchools ? '隐藏学校' : '显示学校'}}</button>
      <button size="mini" bindtap="toggleZones">{{showZones ? '隐藏学区' : '显示学区'}}</button>
    </view>
    <view class="price-row">
      <text>价格（万/㎡）</text>
      <input type="number" data-field="min" value="{{minWan}}" bindinput="handlePriceInput" />
      <text>—</text>
      <input type="number" data-field="max" value="{{maxWan}}" bindinput="handlePriceInput" />
    </view>
    <label class="check-row"><checkbox checked="{{pricedOnly}}" bindtap="togglePricedOnly" />只显示有价小区</label>
    <view class="apply-row">
      <button class="apply-button" size="mini" type="primary" bindtap="applyFilters">应用筛选</button>
      <button class="more-tools" size="mini" bindtap="toggleMoreTools">{{showMoreTools ? '收起工具' : '更多工具'}}</button>
    </view>
    <view wx:if="{{showMoreTools}}" class="export-row">
      <button class="export-button" size="mini" bindtap="exportRankingCsv" loading="{{exportingCsv}}" disabled="{{exportingCsv}}">导出租售比 CSV</button>
      <button class="export-button" size="mini" bindtap="exportHeatmap" loading="{{exportingHeatmap}}" disabled="{{exportingHeatmap}}">导出热力图</button>
    </view>
  </view>
  <view wx:if="{{!showFilters}}" class="filter-reopen" bindtap="toggleFilters">筛选</view>

  <view wx:if="{{showResults}}" class="results-card">
    <view class="results-head"><text>范围结果 {{total}}</text><text class="close" bindtap="toggleResults">×</text></view>
    <input class="result-filter-input" value="{{resultFilter}}" bindinput="onResultFilterInput" placeholder="在结果中搜索..." confirm-type="search" />
    <scroll-view scroll-y class="results-scroll">
      <view wx:for="{{resultFiltered}}" wx:key="id" data-index="{{index}}" bindtap="handleResultTap" class="result-row">
        <view><text class="result-name">{{item.name}}</text><text class="result-meta">{{item.district}} · {{item.street}}</text></view>
        <text class="result-price">{{item.priceText}}</text>
      </view>

      <view class="ranking-head">
        <text>小区榜单 {{rankingTotal}}</text>
        <view class="ranking-switch">
          <text data-sort="rentYield" class="{{rankingSort === 'rentYield' ? 'active' : ''}}" bindtap="switchRankingSort">租售比</text>
          <text data-sort="price" class="{{rankingSort === 'price' ? 'active' : ''}}" bindtap="switchRankingSort">价格</text>
        </view>
      </view>
      <view wx:if="{{rankingLoading}}" class="ranking-empty">正在加载榜单…</view>
      <view wx:for="{{rankingItems}}" wx:key="id" data-index="{{index}}" bindtap="handleRankingTap" class="result-row ranking-row">
        <view class="rank-row-main">
          <text class="rank-label">{{item.rankLabel}}</text>
          <view><text class="result-name">{{item.name}}</text><text class="result-meta">{{item.district}} · {{item.street}}</text></view>
        </view>
        <text class="result-price">{{item.rankingValue}}</text>
      </view>
      <button wx:if="{{rankingHasMore}}" size="mini" bindtap="loadMoreRanking">加载更多榜单</button>
    </scroll-view>
  </view>

  <view wx:if="{{selected}}" class="detail-card" bindtap="clearSelected">
    <text class="detail-name">{{selected.name}}</text>
    <text wx:if="{{selected.type === 'cluster'}}">当前范围内的聚合小区</text>
    <text wx:elif="{{selected.levelLabel}}">{{selected.district}} · {{selected.levelLabel}}</text>
    <text wx:if="{{selected.priceText}}">{{selected.priceText}}/㎡</text>
    <text wx:if="{{selected.rentText}}">租金：{{selected.rentText}}</text>
    <text wx:if="{{selected.rentYieldText}}">租售比：{{selected.rentYieldText}}</text>
    <text wx:if="{{selected.refPriceText}}">官方参考价：{{selected.refPriceText}}</text>
    <text wx:if="{{selected.refGapText}}">{{selected.refGapText}}</text>
    <text wx:if="{{selected.historyTrendText}}">价格趋势：{{selected.historyTrendText}}</text>
    <view wx:if="{{selected.historyRows.length}}" class="history-list">
      <view wx:for="{{selected.historyRows}}" wx:key="key" class="history-row">
        <text>{{item.dateText}}</text><text>{{item.priceText}}</text>
      </view>
    </view>
    <text wx:if="{{selected.historyTruncated}}" class="history-note">仅展示最近 {{selected.historyRows.length}} 条记录</text>
    <text wx:if="{{selected.address}}">{{selected.address}}</text>
    <text wx:if="{{selected.phoneText}}">电话：{{selected.phoneText}}</text>
    <text wx:if="{{selected.zoneText}}">招生社区：{{selected.zoneText}}</text>
    <text wx:if="{{selected.degreeTimeText}}">学位时间：{{selected.degreeTimeText}}</text>
    <text wx:if="{{selected.degreePolicyNote}}">政策：{{selected.degreePolicyNote}}</text>
    <text wx:if="{{selected.nearbySchoolsText}}">附近学校：{{selected.nearbySchoolsText}}</text>
    <button wx:if="{{selected.type === 'cluster'}}" size="mini" type="primary" catchtap="expandCluster">放大查看具体小区</button>
    <text wx:if="{{selectedLoading}}">正在加载详情…</text>
  </view>

  <view wx:if="{{loading}}" class="loading-mask">正在加载地图…</view>
  <view wx:if="{{error}}" class="error-card">
    <text>{{error}}</text>
    <button size="mini" type="primary" bindtap="retry">重试</button>
  </view>

  <canvas wx:if="{{exportingHeatmap}}" type="2d" id="heatmap-canvas" class="heatmap-canvas"></canvas>

  <view wx:if="{{showMethodology}}" class="methodology-mask" bindtap="toggleMethodology">
    <view class="methodology-card" catchtap="noop">
      <view class="methodology-head">
        <text class="methodology-title">数据来源与方法</text>
        <text class="methodology-close" bindtap="toggleMethodology">关闭</text>
      </view>
      <text wx:if="{{catalog.disclaimer}}" class="methodology-disclaimer">{{catalog.disclaimer}}</text>
      <scroll-view scroll-y class="methodology-scroll">
        <view wx:for="{{catalog.scopes}}" wx:key="id" class="scope-card">
          <view class="scope-head">
            <text class="scope-label">{{item.label}}</text>
            <text class="scope-status {{item.status}}">{{item.status === 'active' ? '已接入' : item.status === 'planned' ? '待接入' : '已停用'}}</text>
          </view>
          <text wx:if="{{item.source.name}}" class="scope-source">{{item.source.name}}</text>
          <text wx:if="{{item.sourceVersion}}" class="scope-line">版本：{{item.sourceVersion}}</text>
          <text wx:if="{{item.licenseNote}}" class="scope-line">{{item.licenseNote}}</text>
          <text wx:if="{{item.disclaimer}}" class="scope-note">{{item.disclaimer}}</text>
        </view>
      </scroll-view>
      <text wx:if="{{catalog.dataVersion}}" class="methodology-foot">内容版本：{{catalog.dataVersion}}</text>
    </view>
  </view>
</view>
