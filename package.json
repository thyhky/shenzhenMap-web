{
  "name": "shenzhen-estate-map-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:web": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "seed:generate": "node scripts/generate-seed.mjs",
    "update:generate": "node scripts/generate-update.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file seed/seed.sql",
    "db:setup:local": "npm run db:migrate:local && npm run seed:generate && npm run db:seed:local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:remote": "wrangler d1 execute DB --remote --file seed/seed.sql",
    "db:update:local": "npm run update:generate && wrangler d1 execute DB --local --file seed/update.sql",
    "db:update:remote": "npm run update:generate && node scripts/execute-update-parts.mjs",
    "sync:data": "node scripts/sync-data.mjs",
    "pipeline": "node scripts/pipeline.mjs",
    "verify:remote": "node scripts/verify-deployment.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.122.0"
  }
}
