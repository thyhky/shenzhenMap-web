{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "shenzhen-estate-map-uni-preview",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-13",
	"minify": true,
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": "./uniapp/dist/build/h5",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shenzhen-map",
			"database_id": "9e93cc02-f344-4fac-99fc-1eda70bfc398"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	}
}
